#include <string>
#include <vector>
#include <algorithm>

class Solution {
public:
    int lengthOfLongestSubstring(std::string s) {
        std::vector<int> m(128, -1);
        int max_len = 0;
        int left = 0;
        
        for (int right = 0; right < s.length(); ++right) {
            if (m[s[right]] >= left) {
                left = m[s[right]] + 1;
            }
            m[s[right]] = right;
            max_len = std::max(max_len, right - left + 1);
        }
        
        return max_len;
    }
};
